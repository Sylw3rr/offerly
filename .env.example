# Copy to .env and fill in. Never commit .env.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Anon (public) key — safe for the browser, RLS still applies
SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_KEY=

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
# Base URL the app is served from. Session cookies are marked Secure when
# this begins with https://, and recovery links are built from it.
APP_BASE_URL=http://127.0.0.1:8000

# --- Email ingest (v0.2) ----------------------------------------------------
# Domain used for per-user forwarding addresses, e.g. offerly.com.pl
INGEST_DOMAIN=
# Shared secret verifying the inbound-email webhook
INGEST_WEBHOOK_SECRET=

# --- Optional AI (v0.3) -----------------------------------------------------
# Leave empty to run without any AI features.
ANTHROPIC_API_KEY=

# Reads job adverts out of forwarded board alerts. Without it, only the
# boards with a hand-written parser are read (pracuj.pl today) and the rest
# stay in the inbox as they arrived.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Reminder mail. Empty means reminders are computed but never sent — which is
# what you want everywhere except production.
RESEND_API_KEY=
MAIL_FROM=Offerly <przypomnienia@offerly.com.pl>
